<Window x:Class="ParetoTool.Views.ProjectWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ParetoTool.Views" xmlns:local1="clr-namespace:ParetoTool.Controls"
        mc:Ignorable="d"
        MinHeight="230"
        Title="Project" Height="230" Width="509" x:Name="ProjectWindowMain" Topmost="True" WindowStartupLocation="CenterScreen" ShowInTaskbar="False" ResizeMode="NoResize">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="30"/>
            <RowDefinition Height="65"/>
            <RowDefinition Height="72"/>
            <RowDefinition Height="114"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="120"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Label Grid.Row="0" Margin="5,2,0,2" x:Name="ProjectName">Project Name:</Label>
        <TextBox Grid.Column="1" x:Name="ProjectNameTextBox" Margin="5,6,14,5">
        </TextBox>
        <Label Grid.Row="1" Grid.Column="0" x:Name="ProjectDescriptionValue" Margin="5,1,0,38">Project Description:</Label>
        <TextBox Grid.Row="1" Grid.Column="1" x:Name="ProjectDescriptionTextBox" Margin="5,6,15,9"/>
        <Label Grid.Row="2" Grid.Column="0" x:Name="ProjectTags" Margin="5,2,0,44">Tags:</Label>
        <local1:TagEditorControl Grid.Row="2" Grid.Column="1" x:Name="TagEditor" Margin="5,6,14,9"/>
        <Button x:Name="SaveButton" Grid.Row="3" Grid.Column="1" Content="Save" IsEnabled="False" Width="75" Height="30" HorizontalAlignment="Right" Margin="0,9,107,75" Click="SaveProject_Click"/>
        <Button Grid.Row="3" Grid.Column="1" x:Name="CloseButton" Content="Close" Width="75" Height="30" HorizontalAlignment="Right" Margin="0,9,14,75" Click="Close_Click"/>
    </Grid>
</Window>
