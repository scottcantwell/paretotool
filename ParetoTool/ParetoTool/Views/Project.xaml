<Window x:Class="ParetoTool.Views.ProjectWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ParetoTool.Views" xmlns:local1="clr-namespace:ParetoTool.Controls"
        mc:Ignorable="d"
        MinHeight="255"
        Title="{Binding WindowTitle}" Height="275" Width="509" x:Name="ProjectWindowMain" Topmost="True" WindowStartupLocation="CenterScreen" ShowInTaskbar="False" ResizeMode="NoResize" DataContext="{Binding RelativeSource={RelativeSource Self}}">
    <Window.Resources>
        <Style x:Key="RoundedTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="BorderBrush" Value="#C8C8C8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8"
                            SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost"
                                      Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#8FBFB5"/>
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#2E8B7A"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="#F0F0F0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="30"/>
            <RowDefinition Height="65"/>
            <RowDefinition Height="72"/>
            <RowDefinition Height="114"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="120"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Label Grid.Row="0" Margin="5,2,0,2" x:Name="ProjectName">Project Name:</Label>
        <TextBox Grid.Column="1" x:Name="ProjectNameTextBox" Margin="5,6,14,5" Style="{StaticResource RoundedTextBox}" TextWrapping="NoWrap" Text="{Binding ProjectName, UpdateSourceTrigger=PropertyChanged}" >
        </TextBox>
        <Label Grid.Row="1" Grid.Column="0" x:Name="ProjectDescriptionValue" Margin="5,1,0,38">Project Description:</Label>
        <TextBox Grid.Row="1" Grid.Column="1" x:Name="ProjectDescriptionTextBox" Margin="5,6,15,9" Style="{StaticResource RoundedTextBox}" TextWrapping="Wrap" Text="{Binding ProjectDescription, 
            UpdateSourceTrigger=PropertyChanged}" FontSize="10"/>
        <Label Grid.Row="2" Grid.Column="0" x:Name="ProjectTags" Margin="5,2,0,44">Tags:</Label>
        <Label Grid.Row="3" Grid.Column="0" x:Name="ProjectDataSource" Margin="5,1,0,76">Data Source:</Label>
        <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Margin="5,2,14,88">
            <CheckBox x:Name="ManualInputCheckBox" Content="Manual Entry"  IsChecked="{Binding IsDataSourceEnabled}" VerticalAlignment="Center" Margin="0,0,5,0"/>
            <CheckBox x:Name="FileInputCheckBox" Content="File Input" IsChecked="{Binding IsDataSourceEnabled}" VerticalAlignment="Center"/>    
            <CheckBox x:Name="DatabaseInputCheckBox" Content="Database Input" IsChecked="{Binding IsDataSourceEnabled}" VerticalAlignment="Center" Margin="5,0,0,0"/>   
        </StackPanel>
        <local1:TagEditorControl Grid.Row="2" Grid.Column="1" x:Name="TagEditor" Margin="5,6,14,9" Tags="{Binding Tags}" />
        <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,14,42">
            <Button x:Name="SaveButton" Content="Save" Width="75" Height="30" Click="SaveProject_Click" IsEnabled="{Binding CanSave}"/>
            <Button x:Name="CloseButton" Content="Close" Width="75" Height="30" Click="Close_Click" Margin="5,0,0,0"/>
        </StackPanel>

    </Grid>
</Window>
