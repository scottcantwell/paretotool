<Window x:Class="ParetoTool.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ParetoTool.Controls"
        Title="ParetoTool"
        Height="720" Width="1200"
        MinHeight="500" MinWidth="800"
        Background="{StaticResource BgBrush}"
        FontFamily="Segoe UI" FontSize="13"
        Foreground="{StaticResource TextBrush}">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" MinHeight="28"/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="340" MinWidth="240"/>
            <ColumnDefinition Width="6"/>
            <ColumnDefinition Width="*" MinWidth="360"/>
        </Grid.ColumnDefinitions>
        <StackPanel>
            <Menu Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3">
                <MenuItem Header="File">
                    <MenuItem Header="New Project" Click="NewProject_Click" x:Name="NewProjectMenuItem"/>
                    <MenuItem Header="Open Project" Click="OpenProject_Click" x:Name="OpenProjectMenuItem"/>
                    <MenuItem Header="Edit Project" Click="EditProject_Click" x:Name="EditProjectMenuItem"/>
                    <Separator></Separator>
                    <MenuItem Header="Save Project" Click="SaveProject_Click" x:Name="SaveProjectMenuItem"/>
                    <MenuItem Header="Save Project As..." Click="SaveProjectAs_Click" x:Name="SaveProjectAsMenuItem"/>
                    <Separator x:Name="SeparatorOneMenuItem"/>
                    <MenuItem Header="Recent Projects" x:Name="RecentProjectsMenuItem"></MenuItem>
                    <Separator x:Name="SeparatorTwoMenuItem"/>
                    <MenuItem Header="Exit" Click="Exit_Click" x:Name="ExitMenuItem"/>
                </MenuItem>
                <MenuItem Header="Edit">
                    <MenuItem Header="Cut" Click="Cut_Click" x:Name="CutMenuItem"/>
                    <MenuItem Header="Copy" Click="Copy_Click" x:Name="CopyMenuItem"/>
                    <MenuItem Header="Paste" Click="Paste_Click" x:Name="PasteMenuItem"/>
                </MenuItem>
                <MenuItem Header="Actions">
                    <MenuItem Header="Add Row" Click="AddRow_Click" x:Name="AddRowMenuItem"/>
                    <MenuItem Header="Clear Data" Click="Clear_Click" x:Name="ClearMenuItem"/>
                    <MenuItem Header="Generate Chart" Click="Generate_Chart_Click" x:Name="GenerateMenuItem"/>
                </MenuItem>
                <MenuItem Header="View">
                    <MenuItem Header="Chart" Click="Chart_Click" x:Name="ChartMenuItem" IsCheckable="True" IsChecked="True"/>
                    <MenuItem Header="Input Data" Click="InputData_Click" x:Name="InputDataMenuItem" IsCheckable="True" IsChecked="True"/>
                    <MenuItem Header="Transformed Data" Click="TransformedData_Click" x:Name="TransformedDataMenuItem" IsCheckable="True" IsChecked="True"/>
                </MenuItem>
                <MenuItem Header="Help">
                    <MenuItem Header="Help" Click="Help_Click" x:Name="HelpMenuItem"/>
                    <Separator x:Name="SeparatorOneMenuItemHelp"/>
                    <MenuItem Header="About" Click="About_Click" x:Name="AboutMenuItem"/>
                </MenuItem>
            </Menu>
            <StackPanel Orientation="Horizontal">
            <ToolBarPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" Height="40" Width="350" Margin="0,5,0,0" HorizontalAlignment="Left">
                <ToolBar Width="441" Height="40">
                    <Button Content="New Project" Click="NewProject_Click" x:Name="NewProjectButton"/>
                    <Separator/>
                    <Button Content="Open Project" Click="OpenProject_Click" x:Name="OpenProjectButton"/>
                     <Button Content="Save Project" Click="SaveProject_Click" x:Name="SaveProjectButton"/>
                     <Separator/>
                     <Button Content="Get Data" Click="AddRow_Click" x:Name="AddRowButton"/>
                    <Separator/>
                    <Button Content="Generate Chart" Click="Generate_Chart_Click" x:Name="GenerateChartButton" Visibility="Visible"/>
                    </ToolBar>
            </ToolBarPanel>
                <ToolBarPanel Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="1" Height="40" Width="450" Margin="5,3,0,0" Visibility="Visible" >
                <ToolBar Width="450" Height="40">
                    <Button Content="Add Row" Click="AddRow_Click" x:Name="AddRowButton2" Visibility="Visible"/>
                    <Button Content="Remove Row" Click="Clear_Click" x:Name="ClearButton" Visibility="Visible"/>
                    <Button Content="Clear Data" Click="Clear_Click" x:Name="ClearButton2" Visibility="Visible"/>
                    <Separator/>
                    </ToolBar>
            </ToolBarPanel>
            </StackPanel>
        </StackPanel>
        <GroupBox Grid.Row="1" Grid.Column="0"
                  Header="Input Data"
                  BorderBrush="Black">
            <DockPanel>
                <ToolBarPanel DockPanel.Dock="Top" Margin="0,0,0,8" x:Name="InputDataToolBarPanel">
                    <ToolBar>
                        <Button Content="Add" Click="AddRow_Click" Visibility="Visible"/>
                        <Button Content="Refresh" Visibility="Hidden" Click="Refresh_Click"/>
                        <Button Content="Remove" Style="{StaticResource SecondaryButton}" Click="RemoveRow_Click" Visibility="Visible"/>
                        <Separator/>
                        <Button Content="Chart" Click="Generate_Chart_Click" Visibility="Visible"/>
                        <Button Content="Clear" Style="{StaticResource SecondaryButton}" Click="Clear_Click" Visibility="Visible"/>
                        <Separator/>
                        <Button Content="Sample Data" Style="{StaticResource SecondaryButton}" Click="Sample_Click" Visibility="Visible"/>
                    </ToolBar>
                </ToolBarPanel>
                <DataGrid x:Name="InputGrid"
                          AutoGenerateColumns="False"
                          CanUserAddRows="True"
                          CanUserDeleteRows="True"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          AlternatingRowBackground="#F8FAFC"
                          RowBackground="White"
                          BorderBrush="{StaticResource BorderBrushKey}"
                          BorderThickness="1"
                          Margin="6,0,6,0"
                          ItemsSource="{Binding InputItems}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Category" Binding="{Binding Category, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                        <DataGridTextColumn Header="Value" Binding="{Binding Value, UpdateSourceTrigger=PropertyChanged}" Width="90"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </GroupBox>
        <GridSplitter Grid.Row="1" Grid.Column="1"
                      HorizontalAlignment="Stretch"
                      Background="Transparent"
                      ShowsPreview="True"/>

        <Grid Grid.Row="1" Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="2*" MinHeight="180"/>
                <RowDefinition Height="6"/>
                <RowDefinition Height="*" MinHeight="140"/>
            </Grid.RowDefinitions>
            <GroupBox Header="Pareto Chart" BorderBrush="Black" Grid.Row="0" Margin="3,2,2,0">
                <!--<Border Grid.Row="0"
                    Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource BorderBrushKey}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="8">-->
                <local:ParetoChart x:Name="Chart"/>
            </GroupBox>
            <!--</Border>-->
            <GridSplitter Grid.Row="1"
                          Height="6"            
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          Background="Transparent"
                          ShowsPreview="True"
                          ResizeDirection="Rows"/>
            <GroupBox Header="Transformed Data" BorderBrush="Black" Grid.Row="2" Margin="3,0,0,0">
                <DockPanel Grid.Row="2">
                    <ToolBarPanel DockPanel.Dock="Top" Margin="2,4,0,2" x:Name="TransformedDataToolBarPanel">
                        <ToolBar BorderThickness="1">
                            <Button Content="Copy" Click="CopyTransformedData_Click"/>
                            <Button Content="Export" Style="{StaticResource SecondaryButton}" Click="ExportTransformedData_Click"/>
                        </ToolBar>
                    </ToolBarPanel>
                    <!--<Border Grid.Row="2"
                    Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource BorderBrushKey}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="12">-->
                    <DockPanel>
                        <!--<TextBlock DockPanel.Dock="Top"
                               Text="Transformed data"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Margin="0,0,0,8"/>-->
                        <DataGrid x:Name="ResultGrid"
                              Margin="3,0,0,0"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              AlternatingRowBackground="#F8FAFC"
                              RowBackground="White"
                              BorderBrush="{StaticResource BorderBrushKey}"
                              BorderThickness="2"
                              ItemsSource="{Binding ParetoRows}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Rank" Binding="{Binding Rank}" Width="60"/>
                                <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="*"/>
                                <DataGridTextColumn Header="Value" Binding="{Binding Value, StringFormat=N2}" Width="90"/>
                                <DataGridTextColumn Header="%" Binding="{Binding Percentage, StringFormat=N1}" Width="70"/>
                                <DataGridTextColumn Header="Cumulative value" Binding="{Binding CumulativeValue, StringFormat=N2}" Width="130"/>
                                <DataGridTextColumn Header="Cumulative %" Binding="{Binding CumulativePercentage, StringFormat=N1}" Width="110"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                    <!--</Border>-->
                </DockPanel>
            </GroupBox>
        </Grid>
    </Grid>
</Window>
