<Window x:Class="ParetoTool.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ParetoTool"
        Title="ParetoTool"
        Height="720" Width="1200"
        MinHeight="500" MinWidth="800"
        Background="{StaticResource BgBrush}"
        FontFamily="Segoe UI" FontSize="13"
        Foreground="{StaticResource TextBrush}">
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="340" MinWidth="240"/>
            <ColumnDefinition Width="6"/>
            <ColumnDefinition Width="*" MinWidth="360"/>
        </Grid.ColumnDefinitions>

        <!-- LEFT: data entry -->
        <Border Grid.Column="0" Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderBrushKey}" BorderThickness="1" CornerRadius="6" Padding="12">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="Input data" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <TextBlock Text="Enter categories and values. Empty or non-positive rows are ignored."
                               TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,10"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <Button Content="Add row" Click="AddRow_Click"/>
                        <Button Content="Remove selected" Style="{StaticResource SecondaryButton}" Click="RemoveRow_Click"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Content="Generate chart" Click="Generate_Click"/>
                        <Button Content="Sample data" Style="{StaticResource SecondaryButton}" Click="Sample_Click"/>
                        <Button Content="Clear" Style="{StaticResource SecondaryButton}" Click="Clear_Click"/>
                    </StackPanel>
                    <TextBlock x:Name="StatusText" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
                </StackPanel>

                <DataGrid x:Name="InputGrid"
                          AutoGenerateColumns="False"
                          CanUserAddRows="True"
                          CanUserDeleteRows="True"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          AlternatingRowBackground="#F8FAFC"
                          RowBackground="White"
                          BorderBrush="{StaticResource BorderBrushKey}"
                          BorderThickness="1"
                          ItemsSource="{Binding InputItems}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Category" Binding="{Binding Category, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                        <DataGridTextColumn Header="Value" Binding="{Binding Value, UpdateSourceTrigger=PropertyChanged}" Width="90"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>

        <GridSplitter Grid.Column="1"
                      Width="6"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch"
                      Background="Transparent"
                      ShowsPreview="True"/>

        <!-- RIGHT: chart + transformed data -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="2*" MinHeight="180"/>
                <RowDefinition Height="6"/>
                <RowDefinition Height="*" MinHeight="140"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource BorderBrushKey}" BorderThickness="1" CornerRadius="6" Padding="8">
                <local:ParetoChart x:Name="Chart"/>
            </Border>

            <GridSplitter Grid.Row="1"
                          Height="6"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          Background="Transparent"
                          ShowsPreview="True"
                          ResizeDirection="Rows"/>

            <Border Grid.Row="2" Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource BorderBrushKey}" BorderThickness="1" CornerRadius="6" Padding="12">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Transformed data"
                               FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <DataGrid x:Name="ResultGrid"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              AlternatingRowBackground="#F8FAFC"
                              RowBackground="White"
                              BorderBrush="{StaticResource BorderBrushKey}"
                              BorderThickness="1"
                              ItemsSource="{Binding ParetoRows}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Rank" Binding="{Binding Rank}" Width="60"/>
                            <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="*"/>
                            <DataGridTextColumn Header="Value" Binding="{Binding Value, StringFormat=N2}" Width="90"/>
                            <DataGridTextColumn Header="%" Binding="{Binding Percentage, StringFormat=N1}" Width="70"/>
                            <DataGridTextColumn Header="Cumulative value" Binding="{Binding CumulativeValue, StringFormat=N2}" Width="130"/>
                            <DataGridTextColumn Header="Cumulative %" Binding="{Binding CumulativePercentage, StringFormat=N1}" Width="110"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Window>