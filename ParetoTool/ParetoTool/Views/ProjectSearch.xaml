<Window x:Class="ParetoTool.Views.ProjectSearch"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ParetoTool.Views"
        mc:Ignorable="d"
        Title="Search for Project" Height="410" Width="615">
    <Grid Margin="0,0,0,51">
        <Grid.RowDefinitions>
            <RowDefinition Height="61"/>
            <RowDefinition Height="176*"/>
            <RowDefinition Height="Auto" MinHeight="23"/>
            <RowDefinition Height="91*"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="5,5,5,30">
            <Label Content="Search:" VerticalAlignment="Center"/>
            <TextBox x:Name="SearchTextBox" Width="295" Margin="0,0,5,0" Height="25"/>
            <ComboBox Height="25" Width="100" Margin="0,0,5,0" x:Name="SearchCriteriaComboBox">
                <ComboBoxItem Content="Project Name" IsSelected="True"/>
                <ComboBoxItem Content="Tag(s)"/>
            </ComboBox>
            <Button Content="Search" Width="75" Height="26" Click="SearchButton_Click" VerticalContentAlignment="Center"/>
            <Button Content="Clear" Width="75" Height="26" Click="ClearButton_Click" VerticalContentAlignment="Center"/>
        </StackPanel>
        <CheckBox Content="Match Case" Grid.Row="0" Margin="55,40,0,0"/>
        <GroupBox Header="{Binding SearchResultsCount}" Grid.Row="1" Margin="10,5,10,10">
            <ListView x:Name="SearchResultsListView" Margin="5,5,5,2">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Project Name" DisplayMemberBinding="{Binding ProjectName}" Width="200" x:Name="ProjectNameColumn"/>
                        <GridViewColumn Header="Path" DisplayMemberBinding="{Binding Path}" Width="250" x:Name="PathColumn"/>
                    </GridView>
                </ListView.View>
            </ListView>
        </GroupBox>
        <StackPanel Orientation="Horizontal" Grid.Row="3" Margin="0,8,10,41" HorizontalAlignment="Right" Width="218">
            <Button Content="Open Project" x:Name="OpenProjectButton" Height="32" Width="100" Margin="0,0,15,0"></Button>
            <Button Content="Close" Click="CloseButton_Click" Margin="0,0,5,0" Height="32" Width="100" x:Name="CloseButton"/>
        </StackPanel>

    </Grid>
</Window>
