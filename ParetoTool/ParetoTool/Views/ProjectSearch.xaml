<Window x:Class="ParetoTool.Views.ProjectSearch"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ParetoTool.Views"
        mc:Ignorable="d"
        Title="Search for Project" Height="450" Width="615">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="100"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="5,5,5,65">
            <Label Content="Search:" VerticalAlignment="Center"/>
            <TextBox x:Name="SearchTextBox" Width="295" Margin="0,0,5,0" Height="25"/>
            <ComboBox Height="25" Width="100" Margin="0,0,5,0" x:Name="SearchCriteriaComboBox">
                <ComboBoxItem Content="Project Name" IsSelected="True"/>
                <ComboBoxItem Content="Tag(s)"/>   
            </ComboBox>
            <Button Content="Search" Width="75" Height="25" Click="SearchButton_Click"/>
            <Button Content="Clear" Width="75" Height="25" Click="ClearButton_Click"/>
        </StackPanel>
        <GroupBox Header="Search Results" Grid.Row="1" Margin="10,5,10,10">
            <ListBox x:Name="ResultsListBox" Margin="5"/>
        </GroupBox>
        <Button Content="Close" Grid.Row="2" Width="75" Height="25" Click="CloseButton_Click" Margin="0,30,24,142" Grid.RowSpan="3"/>
    </Grid>
</Window>
