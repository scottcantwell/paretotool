<Window
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="d" x:Class="ParetoTool.Views.HelpWindow"
        Title="Help" SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterOwner"
        Height="Auto"
        ResizeMode="NoResize"
        MinWidth="300" d:DesignHeight="195.222" Loaded="Window_Loaded">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="InstructionsText" TextWrapping="Wrap" Width="300" Margin="0,0,0,10"/>
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="CloseButton" Content="Close" Width="75" Margin="0,0,10,0" Click="CloseButton_Click"/>
                <Button Content="Add Sample Data" Width="150" Click="AddSampleData_Click"/>
        </StackPanel>
    </Grid>
</Window>
