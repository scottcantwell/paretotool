<Window x:Class="ParetoTool.Views.StartWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title=""
        Width="882" Height="598"
        MinWidth="760" MinHeight="480"
        WindowStartupLocation="CenterScreen"
        Background="White"
        FontFamily="Segoe UI"
        FontSize="12"
        Foreground="#1E1E1E"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">
    <Window.InputBindings>
        <KeyBinding Key="S" Modifiers="Alt" Command="{Binding FocusSearchCommand}"/>
    </Window.InputBindings>
    <Window.Resources>
        <SolidColorBrush x:Key="Accent" Color="#5649B0"/>
        <SolidColorBrush x:Key="Muted" Color="#767676"/>
        <SolidColorBrush x:Key="PathBrush" Color="#8A8A8A"/>
        <SolidColorBrush x:Key="DateBrush" Color="#333333"/>

        <Geometry x:Key="Chevron">M0,0 L4,4 L8,0</Geometry>

        <Style x:Key="CaptionButton" TargetType="Button">
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#1A1A1A"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E6E6E6"/>
                            </Trigger>
                            <Trigger Property="Tag" Value="Close">
                                <Setter Property="FontSize" Value="10"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="Tag" Value="Close"/>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Bd" Property="Background" Value="#E81123"/>
                                <Setter Property="Foreground" Value="White"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="2,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="2" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#F3F3F3"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="32" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <DockPanel>
        <Border DockPanel.Dock="Bottom" Background="#F9F9F9" BorderBrush="#F0F0F0" BorderThickness="0,1,0,0" Height="45">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                <TextBlock Text="Release Notes" FontSize="12" Foreground="#1A1A1A" Margin="12,0,0,0" VerticalAlignment="Center" FontStyle="Italic" FontWeight="Bold"/>
                <Button Content="Continue" Margin="700,0,0,0" Foreground="Black" Background="LightGray" Visibility="Visible" x:Name="ContinueButton" Click="ContinueButton_Click"/>
         </StackPanel>
        </Border>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="32"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Background="White">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                    <Button Style="{StaticResource CaptionButton}" Content="&#xE922;" Click="Maximize_Click" x:Name="MaximizeButton"/>
                    <Button Style="{StaticResource CaptionButton}" Tag="Close" Content="&#xE8BB;" Click="Close_Click" x:Name="CloseButton"/>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1" Margin="18,2,6,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="228"/>
                </Grid.ColumnDefinitions>

                <DockPanel Grid.Column="0" Margin="0,0,6,0">
                    <TextBlock DockPanel.Dock="Top"
                               Text="What would you like to do?"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Foreground="#1A1A1A"
                               Margin="2,0,0,16"/>

                    <Border DockPanel.Dock="Top" BorderBrush="{StaticResource Accent}" BorderThickness="0,0,0,2" Margin="0,0,10,6" Height="28">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="26"/>
                                <ColumnDefinition Width="22"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="Cue"
                                       Text="Search recent (Alt+S)"
                                       Foreground="#8D8D8D"
                                       FontSize="12.5"
                                       VerticalAlignment="Center"
                                       Margin="2,0,0,2"
                                       IsHitTestVisible="False"/>
                            <TextBox x:Name="SearchBox"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     FontSize="12.5"
                                     VerticalContentAlignment="Center"
                                     Padding="2,0,0,2"
                                     CaretBrush="#1A1A1A"
                                     TextChanged="SearchBox_OnTextChanged"/>
                            <Button Grid.Column="1" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="SearchBox_Focus" ToolTip="Search">
                                <Path Data="M8.2,2.2 A4.6,4.6 0 1 1 3.6,6.8 A4.6,4.6 0 0 1 8.2,2.2 M8.2,1 A5.8,5.8 0 1 0 12.4,12.1 L15.2,14.9 L16.2,13.9 L13.4,11.1 A5.8,5.8 0 0 0 8.2,1 Z"
                                      Fill="#5C5C5C" Width="14" Height="14" Stretch="Uniform"/>
                            </Button>
                            <Button Grid.Column="2" Background="Transparent" BorderThickness="0" Cursor="Hand" ToolTip="Filter">
                                <Path Data="M2,3.2 L6,7.2 L10,3.2" Stroke="#5C5C5C" StrokeThickness="1.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="10" Height="6" Stretch="None"/>
                            </Button>
                        </Grid>
                    </Border>

                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,4,0,0">
                        <ScrollViewer.Resources>
                            <Style TargetType="ScrollBar">
                                <Setter Property="Width" Value="8"/>
                                <Setter Property="Background" Value="Transparent"/>
                            </Style>
                        </ScrollViewer.Resources>
                        <ItemsControl x:Name="RecentList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,6,12,2">
                                        <Button Click="GroupHeader_Click" Cursor="Hand" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Left" Padding="2,4,4,6">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="Bd" Background="Transparent" Padding="{TemplateBinding Padding}" CornerRadius="2">
                                                        <ContentPresenter/>
                                                    </Border>
                                                    <!--<ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Bd" Property="Background" Value="#F6F6F6"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>-->
                                                </ControlTemplate>
                                            </Button.Template>
                                            <StackPanel Orientation="Horizontal">
                                                <Path Data="M1,1 L5,5 L1,9" Stroke="#444" StrokeThickness="1.1" Width="8" Height="8" Stretch="Uniform" VerticalAlignment="Center" Margin="0,1,6,0"
                                                      RenderTransformOrigin="0.5,0.5">
                                                    <Path.RenderTransform>
                                                        <RotateTransform Angle="90"/>
                                                    </Path.RenderTransform>
                                                </Path>
                                                <TextBlock Text="{Binding Heading}" FontWeight="SemiBold" FontSize="12.5" Foreground="#1B1B1B"/>
                                            </StackPanel>
                                        </Button>
                                        <ItemsControl ItemsSource="{Binding Items}" VerticalAlignment="Top" ClipToBounds="True">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Padding="22,3,4,5" Cursor="Hand" MouseLeftButtonUp="RecentItem_Click" Background="Transparent">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Style.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter Property="Background" Value="#F6F6F6"/>
                                                                    </Trigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <Grid Height="34">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="22"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="132"/>
                                                            </Grid.ColumnDefinitions>
                                                            <ContentControl Content="{Binding Icon}" VerticalAlignment="Top" Margin="0,2,0,0" Width="16" Height="16"
                                                                />
                                                            <StackPanel Grid.Column="1" Margin="2,0,8,0">
                                                                <TextBlock Text="{Binding Name}" FontSize="12.5" Foreground="#1E1E1E"  MouseLeftButtonUp="TextBlock_MouseLeftButtonUp" x:Name="NameTextBlock" Tag="{Binding CompletePath}"/>
                                                                <TextBlock Text="{Binding Path}" FontSize="11.5" Foreground="#8A8A8A" TextTrimming="CharacterEllipsis" MouseLeftButtonUp="TextBlock_MouseLeftButtonUp" Margin="0,1,0,0" x:Name="PathTextBlock" Tag="{Binding CompletePath}"/>
                                                            </StackPanel>
                                                            <TextBlock Grid.Column="2" Text="{Binding LastAccessed}" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="#3A3A3A" FontSize="12" Margin="0,0,8,0"/>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
                <StackPanel Grid.Column="1" Margin="14,38,8,0">
                    <Button Style="{StaticResource ActionButton}" Click="CreateProject_Click">
                        <StackPanel Orientation="Horizontal">
                            <Grid Width="16" Height="16" Margin="0,0,8,0">
                                <Path Fill="#1F8A3B" Data="M1,0.5 H9.2 L14.2,5.4 V15.2 H1 Z"/>
                                <Path Fill="White" Data="M9.2,0.5 V5.4 H14.2"/>
                                <Path Fill="White" Data="M6.4,7.2 H8.1 V8.9 H9.8 V10.6 H8.1 V12.3 H6.4 V10.6 H4.7 V8.9 H6.4 Z"/>
                            </Grid>
                            <TextBlock Text="Create a new project" FontSize="12.5" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource ActionButton}" Margin="0,6,0,0" Click="OpenProject_Click">
                        <StackPanel Orientation="Horizontal">
                            <Grid Width="16" Height="16" Margin="0,0,8,0">
                                <Path Fill="#5B4DB5" Data="M1.2,2.4 H7.2 L8.4,3.8 H14.6 V13.6 H1.2 Z"/>
                                <Path Fill="White" Data="M4.2,7.4 H11.4 V8.6 H4.2 Z M7.2,5.2 H8.4 V10.8 H7.2 Z"/>
                            </Grid>
                            <TextBlock Text="Open a project or solution" FontSize="12.5" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource ActionButton}" Margin="0,6,0,0" Click="OpenFolder_Click">
                        <StackPanel Orientation="Horizontal">
                            <Grid Width="16" Height="16" Margin="0,0,8,0">
                                <Path Fill="#C4922A" Data="M1,4.2 H6.4 L7.8,5.6 H15 V6.4 H1 Z"/>
                                <Path Fill="#E0B04A" Data="M1,6.2 H15 V13.2 H1 Z"/>
                                <Path Fill="#3A7BD5" Data="M10.2,8.2 A2.4,2.4 0 1 1 12.8,11.6 L14.4,13.2 L13.4,14.2 L11.8,12.6 A2.4,2.4 0 0 1 10.2,8.2 Z" StrokeThickness="0"/>
                            </Grid>
                            <TextBlock Text="Open a folder" FontSize="12.5" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Grid>
    </DockPanel>
</Window>