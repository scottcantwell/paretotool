<UserControl x:Class="ParetoTool.Controls.DelimitedFileImportControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:ParetoTool.Controls"
             mc:Ignorable="d"
             d:DesignHeight="420" d:DesignWidth="720"
             d:DataContext="{d:DesignInstance Type=controls:DelimitedFileImportViewModel}"
             Background="White">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <Style TargetType="ComboBox">
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="MinHeight" Value="26"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="MinHeight" Value="26"/>
        </Style>
        <Style TargetType="Label">
            <Setter Property="Padding" Value="0,0,0,4"/>
            <Setter Property="Foreground" Value="#2E7D6F"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0">
            <Button DockPanel.Dock="Right"
                    Content="Browse…"
                    Width="90"
                    Margin="12,0,0,0"
                    Click="BrowseButton_Click"/>
            <TextBlock Text="{Binding FileName}"
                       FontSize="20"
                       FontWeight="SemiBold"
                       Foreground="#2E8B7A"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis"/>
        </DockPanel>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <Label Content="File Origin"/>
                <ComboBox ItemsSource="{Binding EncodingOptions}"
                          SelectedItem="{Binding SelectedEncodingOption}"
                          DisplayMemberPath="DisplayName"/>
            </StackPanel>

            <StackPanel Grid.Column="2">
                <Label Content="Delimiter"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="140"/>
                    </Grid.ColumnDefinitions>
                    <ComboBox ItemsSource="{Binding DelimiterOptions}"
                              SelectedItem="{Binding SelectedDelimiterOption}"
                              DisplayMemberPath="DisplayName"/>
                    <TextBox Grid.Column="2"
                             Text="{Binding CustomDelimiter, UpdateSourceTrigger=PropertyChanged}"
                             IsEnabled="{Binding IsCustomDelimiter}"
                             ToolTip="Custom delimiter (supports \t for tab)"/>
                </Grid>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <Label Content="Category column"/>
                <ComboBox ItemsSource="{Binding Columns}"
                          SelectedItem="{Binding SelectedCategoryColumn}"
                          DisplayMemberPath="Header"/>
            </StackPanel>

            <StackPanel Grid.Column="2">
                <Label Content="Data column"/>
                <ComboBox ItemsSource="{Binding Columns}"
                          SelectedItem="{Binding SelectedDataColumn}"
                          DisplayMemberPath="Header"/>
            </StackPanel>
        </Grid>

        <DataGrid x:Name="PreviewGrid"
                  Grid.Row="6"
                  ItemsSource="{Binding PreviewGridRows}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  CanUserReorderColumns="False"
                  HeadersVisibility="Column"
                  GridLinesVisibility="All"
                  AlternatingRowBackground="#F7F7F7"
                  BorderBrush="#D0D0D0"
                  BorderThickness="1"
                  RowHeaderWidth="0"
                  SelectionMode="Single"/>
    </Grid>
</UserControl>
