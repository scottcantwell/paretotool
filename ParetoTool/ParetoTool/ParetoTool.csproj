<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationTitle>ParetoTool</ApplicationTitle>
  </PropertyGroup>
  <ItemGroup>
    <None Remove="images\paretotoollogo_large.png" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="images\paretotoollogo_large.png" />
  </ItemGroup>
  <ItemGroup>
    <Compile Update="Resources\StartWindow.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>StartWindow.resx</DependentUpon>
    </Compile>
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Update="Resources\StartWindow.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>StartWindow.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>
</Project>
